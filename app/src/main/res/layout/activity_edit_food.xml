<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Kembali"
            android:textColor="#355E3B"
            android:textSize="16sp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Bahan Makanan"
            android:textColor="#355E3B"
            android:textSize="25sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perbarui informasi bahan makananmu."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Bahan Makanan" />

        <EditText
            android:id="@+id/etEditFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Wortel"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kategori"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spEditCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etEditQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 2"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Satuan"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spEditUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanggal Kedaluwarsa"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etEditExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dd/MM/yyyy"
            android:focusable="false"
            android:clickable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catatan"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etEditNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tambahkan catatan (opsional)"
            android:gravity="top"
            android:minLines="3"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnUpdateFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Perubahan"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
