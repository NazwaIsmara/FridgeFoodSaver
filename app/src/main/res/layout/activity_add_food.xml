<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Kembali"
            android:textColor="@color/sage_green"
            android:textSize="15sp"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tambah Bahan Makanan"
            android:textColor="@color/dark_green"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Catat persediaan makananmu agar tidak terbuang."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <!-- Image Placeholder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginTop="22dp"
            android:background="@color/light_sage"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥬 🥑 🥕"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Foto bahan makanan"
                android:textColor="@color/dark_green"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Nama Bahan Makanan *"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etFoodName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Contoh: Bayam"
            android:paddingHorizontal="15dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:inputType="textCapSentences" />

        <!-- Category -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Kategori *"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp" />

        <!-- Quantity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Jumlah *"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Contoh: 5"
                android:inputType="numberDecimal"
                android:paddingHorizontal="15dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spUnit"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="8dp" />

        </LinearLayout>

        <!-- Expiry Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tanggal Kedaluwarsa *"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Pilih tanggal kedaluwarsa"
            android:paddingHorizontal="15dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="10dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Catatan (Opsional)"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Tambahkan catatan penyimpanan..."
            android:padding="15dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveFood"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="@color/sage_green"
            android:text="Simpan Bahan Makanan"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="* Wajib diisi"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
